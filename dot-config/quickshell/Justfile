# quickshell — Desktop shell DX

root := justfile_directory()
qml := '{{root}}/shell.qml {{root}}/domain/*.qml {{root}}/domain/models/*.qml {{root}}/domain/workflows/*.qml {{root}}/infra/*.qml {{root}}/adapters/*.qml {{root}}/adapters/components/*.qml {{root}}/adapters/panels/*.qml'

default:
    @just --list

# Run the shell (replaces waybar + swaync + swayosd)
run:
    qs -c quickshell

# Stop the running instance
stop:
    qs -c quickshell kill

# Apply edits live — Quickshell hot-reloads on save
dev: run

# Stop the daemons Quickshell replaces and stop mako from D-Bus-activating
migrate:
    -pkill -x waybar
    -pkill -x swaync
    -pkill -x mako
    -pkill -x swayosd-server
    -systemctl --user mask mako.service

# Toggle the control center
control:
    qs -c quickshell ipc call quickshell toggleControlCenter

# TEMP: force-unlock a stuck lock screen
force-unlock:
    qs -c quickshell ipc call quickshell forceUnlock

# Lint every QML file (needs qt6-qtdeclarative-devel)
lint:
    qmllint -I /usr/lib64/qt6/qml {{qml}}

# Verify all singletons load within the 50 ms budget
load-test:
    python3 {{root}}/tests/test_load.py
