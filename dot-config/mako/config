# =============================================================================
# Mako Notification Daemon
# Hyprland-flavored: glassy, blurred, attached under the bar, mono + accents
# =============================================================================

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------
font=JetBrainsMono Nerd Font 11
padding=18
margin=6
outer-margin=0,12,12,12
width=380
border-size=1
border-radius=0,0,14,14
markup=1
icons=1
icon-location=left
max-icon-size=34
icon-border-radius=10

# Progress bar (used by volume/brightness OSDs)
progress-color=#89b4fa

# Grouping
group-by=app-name
max-visible=5

# -----------------------------------------------------------------------------
# Colors (Catppuccin Mocha) — translucent glass, subtle accents
# -----------------------------------------------------------------------------
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#45475a

# -----------------------------------------------------------------------------
# Position & Layer
# -----------------------------------------------------------------------------
anchor=top-right
layer=overlay
default-timeout=5000

# -----------------------------------------------------------------------------
# Urgency Levels
# -----------------------------------------------------------------------------
[urgency=low]
background-color=#1e1e2ee6
text-color=#a6adc8
border-color=#6c7086
default-timeout=3000

[urgency=normal]
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
default-timeout=5000

[urgency=high]
background-color=#1e1e2ee6
text-color=#f9e2af
border-color=#f9e2af
default-timeout=8000

[urgency=critical]
background-color=#f38ba8f0
text-color=#11111b
border-color=#f38ba8
border-size=1
default-timeout=0

# -----------------------------------------------------------------------------
# OSD (volume / brightness) — thin bar centered at the top
# -----------------------------------------------------------------------------
[app-name=volume]
anchor=top-center
width=20
height=200
progress-color=#89b4fa
border-radius=0,0,10,10

[app-name=brightness]
anchor=top-center
width=20
height=200
progress-color=#f9e2af
border-radius=0,0,10,10

# -----------------------------------------------------------------------------
# Semantic accents (mono + accent, no brand rainbow)
# -----------------------------------------------------------------------------

# Battery / power
[app-name=upower]
border-color=#a6e3a1

[app-name=power-profiles-daemon]
border-color=#a6e3a1

[app-name=battery]
border-color=#a6e3a1

[summary="*low battery*"]
border-color=#f38ba8

[summary="*Charging*"]
border-color=#a6e3a1

# Screenshots
[app-name=grim]
border-color=#cba6f7

[summary="*Screenshot*"]
border-color=#cba6f7

[summary="*screenshot*"]
border-color=#cba6f7

# Volume / brightness
[summary="*Volume*"]
border-color=#89b4fa

[summary="*Muted*"]
border-color=#89b4fa

[summary="*Brightness*"]
border-color=#f9e2af

# Updates
[summary="*Update*"]
border-color=#a6e3a1

[summary="*Updates*"]
border-color=#a6e3a1

# Errors / failures
[summary="*Error*"]
border-color=#f38ba8

[summary="*error*"]
border-color=#f38ba8

[summary="*Failed*"]
border-color=#f38ba8

# Success
[summary="*Success*"]
border-color=#a6e3a1

[summary="*Complete*"]
border-color=#a6e3a1

[summary="*Done*"]
border-color=#a6e3a1

# Warnings
[summary="*Warning*"]
border-color=#f9e2af

[summary="*warning*"]
border-color=#f9e2af

# -----------------------------------------------------------------------------
# Ignore Rules (silent notifications)
# -----------------------------------------------------------------------------
[app-name=mpv]
invisible=1