# Hyprland config (hexagonal architecture) — DX commands

root := justfile_directory()
devtools := root / "scripts" / "dev.py"

default:
    @just --list

# ──────────────────────────────────────────────
# Run
# ──────────────────────────────────────────────

# Apply the on-disk config to the running compositor
reload:
    hyprctl reload

run: reload

# Reload on every change to the config tree (falls back to tailing logs)
dev:
    @{{devtools}} watch

# Stream the Hyprland log
logs:
    @{{devtools}} logs

# ──────────────────────────────────────────────
# Test
# ──────────────────────────────────────────────

test: test-unit test-integration

test-unit: test-lua-unit test-python-unit
test-integration: test-lua-integration test-python-integration

# Lua config hexagon
test-lua-unit:
    cd {{root}} && lua tests/run.lua
test-lua-integration:
    cd {{root}} && lua tests/integration/run.lua

# Python helper-script hexagon
test-python-unit:
    cd {{root}} && uv run --with pytest pytest scripts/tests/unit -q
test-python-integration:
    cd {{root}} && uv run --with pytest pytest scripts/tests/integration -q

# End-to-end: reload a live Hyprland session (skips if none is running)
test-e2e:
    @{{devtools}} e2e

# ──────────────────────────────────────────────
# Code quality
# ──────────────────────────────────────────────

lint: lint-lua lint-python
lint-lua:
    @{{devtools}} lint
lint-python:
    cd {{root}} && uvx ruff check scripts

typecheck: typecheck-lua typecheck-python
typecheck-lua:
    @{{devtools}} typecheck
typecheck-python:
    @/usr/bin/python3 -m compileall -q {{root}}/scripts && echo "compileall: ok"

format: format-lua format-python
format-lua:
    @{{devtools}} format
format-python:
    cd {{root}} && uvx ruff format scripts

# ──────────────────────────────────────────────
# Build / deps
# ──────────────────────────────────────────────

build:
    @echo "Nothing to build: Lua config is interpreted at runtime"

clean:
    @{{devtools}} clean
    cd {{root}} && rm -rf .pytest_cache .ruff_cache

install:
    @echo "Install runtime deps from the repo root: just deps"

update:
    @echo "Update runtime deps via your package manager (e.g. sudo dnf upgrade)"

# Full pre-commit check
check: lint typecheck test
