{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-window-width": 380,
  "control-center-width": 380,
  "control-center-height": 600,
  "fit-to-screen": true,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "relative-timestamps": true,
  "image-visibility": "when-available",
  "keyboard-shortcuts": true,
  "transition-time": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "brightness",
    "notifications",
    "buttons-grid#clearbar"
  ],
  "widget-config": {
    "mpris": {
      "image-radius": 12,
      "autohide": true,
      "show-album-art": "always"
    },
    "volume": {
      "label": "󰕾"
    },
    "brightness": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨  Wifi",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi off || nmcli radio wifi on'",
          "update-command": "sh -c 'nmcli radio wifi | grep -q enabled && echo true || echo false'"
        },
        {
          "label": "󰂯  BT",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power off || bluetoothctl power on'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰛨  Night",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && gammastep -x || gammastep -O 3500K'",
          "update-command": "sh -c 'gammastep -p 2>/dev/null | grep -qi override && echo true || echo false'"
        },
        {
          "label": "󰂛  DND",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󰐊  Power",
          "type": "normal",
          "command": "~/.config/waybar/scripts/power/main.sh select"
        },
        {
          "label": "󰹑  Shot",
          "type": "normal",
          "command": "grimblast --freeze copysave area"
        },
        {
          "label": "󰅌  Clip",
          "type": "normal",
          "command": "cliphist wipe"
        },
        {
          "label": "󰌾  Lock",
          "type": "normal",
          "command": "hyprlock"
        },
        {
          "label": "󰤄  Sleep",
          "type": "normal",
          "command": "systemctl suspend"
        }
      ]
    },
    "buttons-grid#clearbar": {
      "buttons-per-row": 1,
      "actions": [
        {
          "label": "󰅖  Clear All",
          "type": "normal",
          "command": "swaync-client -C"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    }
  }
}