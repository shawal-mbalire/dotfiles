# SwayNC config (hexagonal architecture) — DX commands

root := justfile_directory()
scripts := root / "scripts"
main := scripts / "main.py"
devtools := scripts / "dev.py"

default:
    @just --list

# ──────────────────────────────────────────────
# Run
# ──────────────────────────────────────────────

# Write config.json and style.css from the domain models
generate:
    cd {{root}} && uv run python {{main}} generate

# Regenerate and reload the running swaync session
run:
    cd {{root}} && uv run python {{main}} generate --reload

# Reload swaync from the on-disk files
reload:
    cd {{root}} && uv run python {{main}} reload

# Regenerate on every change (inotifywait)
dev:
    @{{devtools}} watch

# Stream the swaync log
logs:
    @{{devtools}} logs

# ──────────────────────────────────────────────
# Test
# ──────────────────────────────────────────────

test: test-unit test-integration

test-unit:
    cd {{root}} && uv run --with pytest pytest scripts/tests/unit -q

test-integration:
    cd {{root}} && uv run --with pytest pytest scripts/tests/integration -q

# ──────────────────────────────────────────────
# Code quality
# ──────────────────────────────────────────────

lint:
    cd {{root}} && uvx ruff check scripts

format:
    cd {{root}} && uvx ruff format scripts

typecheck:
    cd {{root}} && uv run python -m compileall -q {{scripts}} && echo "compileall: ok"

# ──────────────────────────────────────────────
# Build / deps
# ──────────────────────────────────────────────

build: generate

clean:
    cd {{root}} && rm -rf .pytest_cache .ruff_cache build
    find {{root}} -type d -name __pycache__ -prune -exec rm -rf {} +

install:
    @echo "Installing swaync..."
    sudo dnf install -y swaync

update:
    @echo "Update runtime deps via your package manager (e.g. sudo dnf upgrade)"

# Full pre-commit check
check: lint typecheck test
