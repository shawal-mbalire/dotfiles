# Waybar configuration (hexagonal architecture) — DX commands

root := justfile_directory()
scripts := root / "scripts"

default:
    @just --list

# ──────────────────────────────────────────────
# Run
# ──────────────────────────────────────────────

# Restart waybar with the on-disk config
restart:
    @echo "Restarting waybar..."
    killall waybar || true
    waybar &

# Soft reload waybar
reload:
    @echo "Reloading waybar..."
    killall -SIGUSR2 waybar || true

run: restart

# Warm the cache and verify every polled module stays inside budget
dev:
    @{{scripts}}/main.py refresh
    @{{scripts}}/bench.py

# Stream the waybar process log
logs:
    @journalctl --user -f -t waybar

# ──────────────────────────────────────────────
# Test
# ──────────────────────────────────────────────

test: test-unit test-integration

test-unit:
    cd {{root}} && uv run --with pytest pytest scripts/tests/unit -q

test-integration:
    cd {{root}} && uv run --with pytest pytest scripts/tests/integration -q

# Time-budget contract: every polled module must return within 50ms
test-e2e:
    @{{scripts}}/bench.py --budget 50

# ──────────────────────────────────────────────
# Code quality
# ──────────────────────────────────────────────

lint:
    cd {{root}} && uvx ruff check scripts

format:
    cd {{root}} && uvx ruff format scripts

typecheck:
    @/usr/bin/python3 -m compileall -q {{scripts}} && echo "compileall: ok"

# ──────────────────────────────────────────────
# Build / deps
# ──────────────────────────────────────────────

build:
    @echo "Nothing to build: Python is interpreted at runtime"

clean:
    cd {{root}} && rm -rf .pytest_cache .ruff_cache build
    find {{root}} -type d -name __pycache__ -prune -exec rm -rf {} +

install:
    @echo "Installing waybar dependencies..."
    sudo dnf install -y waybar jetbrains-mono-fonts sono-fonts brightnessctl grimblast wireplumber pipewire-utils

install-extra:
    @echo "Installing optional dependencies..."
    sudo dnf install -y kitty network-manager-applet tuned-ppd bluez bluez-tools

update:
    @echo "Update runtime deps via your package manager (e.g. sudo dnf upgrade)"

# Full pre-commit check
check: lint typecheck test
