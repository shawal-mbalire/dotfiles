# Install all dependencies for Fedora
install:
    @echo "Installing waybar dependencies..."
    sudo dnf install -y waybar jetbrains-mono-fonts sono-fonts brightnessctl grimblast wireplumber pipewire-utils

# Install optional dependencies
install-extra:
    @echo "Installing optional dependencies..."
    sudo dnf install -y kitty network-manager-applet tuned-ppd bluez bluez-tools

# Restart waybar
restart:
    @echo "Restarting waybar..."
    killall waybar || true
    waybar &

# Reload waybar (soft reload)
reload:
    @echo "Reloading waybar..."
    killall -SIGUSR2 waybar

# Test all modules and scripts
test:
    #!/usr/bin/env bash
    echo "=== Waybar Module Test ==="
    echo ""
    echo "--- Dependencies ---"
    for cmd in waybar brightnessctl grimblast wpctl nm-connection-editor tuned-adm kitty bluetoothctl fuzzel swaync-client pw-play; do
        printf "%-24s %s\n" "$cmd:" "$(which $cmd 2>/dev/null && echo '✓' || echo '✗ MISSING')"
    done
    echo ""
    echo "--- Module Outputs ---"
    printf "%-24s %s\n" "custom/temp:" "$(~/.config/waybar/scripts/temp-status.sh 2>/dev/null | jq -r .text 2>/dev/null || echo 'FAIL')"
    printf "%-24s %s\n" "wireplumber:" "$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d%%", $2 * 100}' || echo 'FAIL')"
    printf "%-24s %s\n" "backlight:" "$(brightnessctl -m 2>/dev/null | cut -d',' -f4 || echo 'FAIL')"
    printf "%-24s %s\n" "battery:" "$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null || echo 'N/A')"
    echo ""
    echo "--- Services ---"
    printf "%-24s %s\n" "bluetooth:" "$(systemctl is-active bluetooth 2>/dev/null || echo 'inactive')"
    printf "%-24s %s\n" "gammastep:" "$(pgrep -x gammastep >/dev/null && echo 'running' || echo 'not running')"
    printf "%-24s %s\n" "power-profiles:" "$(tuned-adm active 2>/dev/null | awk '{print $NF}' || echo 'N/A')"
    printf "%-24s %s\n" "upower:" "$(systemctl is-active upower 2>/dev/null || echo 'inactive')"
    echo ""
    echo "=== Done ==="
