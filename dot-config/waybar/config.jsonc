{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "custom/icon-clock",
    "clock"
  ],
  "modules-right": [
    "custom/swaync",
    "custom/icon-temp",
    "custom/temp",
    "custom/icon-network",
    "network",
    "custom/icon-power",
    "custom/power",
    "custom/icon-volume",
    "custom/audio",
    "custom/icon-backlight",
    "backlight",
    "custom/icon-battery",
    "battery",
    "custom/icon-bluetooth",
    "bluetooth",
    "tray"
  ],
  "ext/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },
  "custom/swaync": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂜",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂝",
      "dnd-inhibited-none": "󰂝"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C",
    "escape": true,
    "tooltip": true
  },
  "custom/icon-clock": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill clock",
    "interval": 60,
    "signal": 8,
    "tooltip": true
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "tooltip": true
  },
  "custom/icon-temp": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill temp",
    "interval": 5,
    "signal": 8,
    "tooltip": true
  },
  "custom/temp": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py nightlight status",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/main.py nightlight toggle",
    "tooltip": true
  },
  "custom/icon-network": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill network",
    "interval": 5,
    "signal": 8,
    "tooltip": true
  },
  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "{ifname}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "Offline",
    "tooltip-format": "<span foreground='#b4befe' font_weight='bold'>NETWORK</span>\n<span foreground='#6c7086'>Interface</span>  <span foreground='#cdd6f4'>{ifname}</span>\n<span foreground='#6c7086'>IP</span>  <span foreground='#cdd6f4'>{ipaddr}/{cidr}</span>\n<span foreground='#6c7086'>Signal</span>  <span foreground='#cdd6f4'>{signalStrength}%</span>",
    "on-click": "nm-connection-editor",
    "tooltip": true
  },
  "custom/icon-volume": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill volume",
    "interval": 5,
    "tooltip": true,
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
    "signal": 5
  },
  "custom/icon-backlight": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill backlight",
    "interval": 5,
    "signal": 8,
    "tooltip": true,
    "on-scroll-up": "~/.config/waybar/scripts/main.py brightness up",
    "on-scroll-down": "~/.config/waybar/scripts/main.py brightness down"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}%",
    "tooltip-format": "Brightness: {percent}%\nScroll: Adjust\nRight-click: Presets",
    "on-scroll-up": "~/.config/waybar/scripts/main.py brightness up",
    "on-scroll-down": "~/.config/waybar/scripts/main.py brightness down",
    "on-click-right": "~/.config/waybar/scripts/main.py brightness menu",
    "tooltip": true
  },
  "custom/icon-battery": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill battery",
    "interval": 5,
    "signal": 8,
    "tooltip": true
  },
  "battery": {
    "bat": "BAT0",
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "tooltip-format": "<span foreground='#a6e3a1' font_weight='bold'>BATTERY</span>\n<span foreground='#6c7086'>Capacity</span>  <span foreground='#cdd6f4'>{capacity}%</span>\n<span foreground='#6c7086'>Time</span>  <span foreground='#cdd6f4'>{timeTo}</span>",
    "tooltip": true
  },
  "custom/icon-bluetooth": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py pill bluetooth",
    "interval": 5,
    "signal": 8,
    "tooltip": true
  },
  "bluetooth": {
    "format": "",
    "format-connected": "{device_alias}",
    "format-disconnected": "off",
    "tooltip-format": "<span foreground='#89b4fa' font_weight='bold'>BLUETOOTH</span>\n<span foreground='#6c7086'>Left-click</span>  <span foreground='#cdd6f4'>Devices</span>\n<span foreground='#6c7086'>Right-click</span>  <span foreground='#cdd6f4'>Power toggle</span>",
    "on-click": "~/.config/waybar/scripts/main.py bluetooth gui",
    "on-click-right": "~/.config/waybar/scripts/main.py bluetooth power",
    "tooltip": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive": true,
    "tooltip": true
  },
  "custom/icon-power": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py power pill",
    "interval": 30,
    "signal": 7,
    "tooltip": true
  },
  "custom/power": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py power status",
    "interval": 30,
    "signal": 7,
    "on-click": "~/.config/waybar/scripts/main.py power cycle",
    "on-click-right": "~/.config/waybar/scripts/main.py power select",
    "tooltip": true
  },
  "custom/audio": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/main.py audio status",
    "interval": 2,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.config/waybar/scripts/main.py audio select",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true,
    "signal": 5
  }
}
