{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg": {
      "primary": { "$value": "#ffffff", "$type": "color", "$description": "Page background" },
      "secondary": { "$value": "#f8f9fa", "$type": "color", "$description": "Section background" },
      "tertiary": { "$value": "#e9ecef", "$type": "color", "$description": "Muted background" }
    },
    "surface": {
      "primary": { "$value": "#ffffff", "$type": "color", "$description": "Card, modal, dropdown background" },
      "secondary": { "$value": "#f8f9fa", "$type": "color", "$description": "Nested surface" },
      "elevated": { "$value": "#ffffff", "$type": "color", "$description": "Elevated surface (overlays)" }
    },
    "text": {
      "primary": { "$value": "#212529", "$type": "color", "$description": "Headings, important labels" },
      "secondary": { "$value": "rgba(33, 37, 41, 0.7)", "$type": "color", "$description": "Body text, descriptions" },
      "tertiary": { "$value": "rgba(33, 37, 41, 0.5)", "$type": "color", "$description": "Captions, hints" },
      "disabled": { "$value": "rgba(33, 37, 41, 0.3)", "$type": "color", "$description": "Inactive elements" },
      "on-accent": { "$value": "#ffffff", "$type": "color", "$description": "Text on accent-colored backgrounds (buttons, badges)" }
    },
    "border": {
      "primary": { "$value": "#dee2e6", "$type": "color", "$description": "Structural borders" },
      "secondary": { "$value": "#e9ecef", "$type": "color", "$description": "Subtle separators" },
      "focus": { "$value": "#0d6efd", "$type": "color", "$description": "Focus ring" },
      "focus-width": { "$value": "2px", "$type": "dimension", "$description": "Focus ring width" },
      "focus-offset": { "$value": "2px", "$type": "dimension", "$description": "Focus ring offset" }
    },
    "accent": {
      "primary": { "$value": "#0d6efd", "$type": "color", "$description": "Interactive highlights" },
      "secondary": { "$value": "#6c757d", "$type": "color", "$description": "Muted accent" },
      "hover": { "$value": "#0b5ed7", "$type": "color", "$description": "Accent hover" }
    },
    "state": {
      "success": { "$value": "#198754", "$type": "color" },
      "warning": { "$value": "#ffc107", "$type": "color" },
      "error": { "$value": "#dc3545", "$type": "color" },
      "info": { "$value": "#0dcaf0", "$type": "color" },
      "success-soft": { "$value": "#d1e7dd", "$type": "color" },
      "warning-soft": { "$value": "#fff3cd", "$type": "color" },
      "error-soft": { "$value": "#f8d7da", "$type": "color" },
      "info-soft": { "$value": "#cff4fc", "$type": "color" }
    },
    "overlay": {
      "bg": { "$value": "rgba(0, 0, 0, 0.5)", "$type": "color", "$description": "Modal backdrops, scrims" }
    }
  },
  "dimension": {
    "space-xs": { "$value": "4px", "$type": "dimension" },
    "space-sm": { "$value": "8px", "$type": "dimension" },
    "space-md": { "$value": "16px", "$type": "dimension" },
    "space-lg": { "$value": "24px", "$type": "dimension" },
    "space-xl": { "$value": "32px", "$type": "dimension" },
    "space-2xl": { "$value": "48px", "$type": "dimension" },
    "space-3xl": { "$value": "64px", "$type": "dimension" },
    "size-sidebar": { "$value": "250px", "$type": "dimension" },
    "size-modal-max": { "$value": "500px", "$type": "dimension" },
    "size-toast-min": { "$value": "300px", "$type": "dimension" },
    "size-toast-max": { "$value": "450px", "$type": "dimension" },
    "size-icon-sm": { "$value": "16px", "$type": "dimension" },
    "size-spinner-sm": { "$value": "20px", "$type": "dimension" },
    "size-spinner-md": { "$value": "40px", "$type": "dimension" },
    "size-spinner-lg": { "$value": "60px", "$type": "dimension" }
  },
  "borderRadius": {
    "sm": { "$value": "3px", "$type": "dimension", "$description": "Small elements (badges, tags)" },
    "md": { "$value": "5px", "$type": "dimension", "$description": "Standard components" },
    "lg": { "$value": "8px", "$type": "dimension", "$description": "Elevated surfaces, modals" },
    "xl": { "$value": "12px", "$type": "dimension", "$description": "Large containers, Pattern 3" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Pill shapes, circles" },
    "outer-sm": { "$value": "4px", "$type": "dimension", "$description": "Pattern 4 compact shells" },
    "outer-md": { "$value": "8px", "$type": "dimension", "$description": "Pattern 4 standard surfaces" },
    "outer-lg": { "$value": "12px", "$type": "dimension", "$description": "Pattern 4 containers, cards" },
    "outer-xl": { "$value": "16px", "$type": "dimension", "$description": "Pattern 4 modals, overlays" },
    "inner-sm": { "$value": "2px", "$type": "dimension", "$description": "Pattern 4 feedback wells" },
    "inner-md": { "$value": "6px", "$type": "dimension", "$description": "Pattern 4 standard wells" },
    "inner-lg": { "$value": "10px", "$type": "dimension", "$description": "Pattern 4 container wells" },
    "inner-xl": { "$value": "14px", "$type": "dimension", "$description": "Pattern 4 overlay wells" }
  },
  "borderWidth": {
    "default": { "$value": "1px", "$type": "dimension", "$description": "Standard structural borders (Pattern 1)" }
  },
  "fontWeight": {
    "light": { "$value": "300", "$type": "fontWeight", "$description": "Large display text, decorative headings" },
    "normal": { "$value": "400", "$type": "fontWeight" },
    "medium": { "$value": "500", "$type": "fontWeight" },
    "semibold": { "$value": "600", "$type": "fontWeight" },
    "bold": { "$value": "700", "$type": "fontWeight" }
  },
  "fontSize": {
    "xs": { "$value": "12px", "$type": "dimension" },
    "sm": { "$value": "14px", "$type": "dimension" },
    "base": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "18px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "2xl": { "$value": "24px", "$type": "dimension" },
    "3xl": { "$value": "30px", "$type": "dimension" },
    "4xl": { "$value": "36px", "$type": "dimension" },
    "5xl": { "$value": "48px", "$type": "dimension" },
    "6xl": { "$value": "60px", "$type": "dimension" },
    "7xl": { "$value": "72px", "$type": "dimension" }
  },
  "lineHeight": {
    "tight": { "$value": "1.2", "$type": "number" },
    "normal": { "$value": "1.5", "$type": "number" },
    "relaxed": { "$value": "1.75", "$type": "number" }
  },
  "fontFamily": {
    "heading": { "$value": "var(--font-heading)", "$type": "fontFamily" },
    "body": { "$value": "var(--font-body)", "$type": "fontFamily" },
    "mono": { "$value": "var(--font-mono)", "$type": "fontFamily" }
  },
  "shadow": {
    "sm": { "$value": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)", "$type": "shadow", "$description": "Subtle resting" },
    "md": { "$value": "0 0.5rem 1rem rgba(0, 0, 0, 0.15)", "$type": "shadow", "$description": "Card resting" },
    "lg": { "$value": "0 1rem 3rem rgba(0, 0, 0, 0.175)", "$type": "shadow", "$description": "Card hover, dropdown" },
    "xl": { "$value": "0 1rem 3rem rgba(0, 0, 0, 0.25)", "$type": "shadow", "$description": "Modals, dialogs" },
    "hover": { "$value": "0 0.5rem 0.9375rem rgba(0, 0, 0, 0.08)", "$type": "shadow", "$description": "Interactive lift" },
    "active": { "$value": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.03)", "$type": "shadow", "$description": "Pressed" }
  },
  "duration": {
    "instant": { "$value": "0ms", "$type": "duration" },
    "fast": { "$value": "100ms", "$type": "duration", "$description": "Micro-interactions" },
    "normal": { "$value": "200ms", "$type": "duration", "$description": "Standard transitions" },
    "slow": { "$value": "300ms", "$type": "duration", "$description": "Complex animations" },
    "morph": { "$value": "350ms", "$type": "duration", "$description": "Dual-radius morph (Pattern 4)" },
    "slower": { "$value": "500ms", "$type": "duration", "$description": "Page transitions" },
    "spinner": { "$value": "1000ms", "$type": "duration", "$description": "Spinner rotation cycle" },
    "loading": { "$value": "1500ms", "$type": "duration", "$description": "Skeleton shimmer cycle" }
  },
  "easing": {
    "default": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Most transitions" },
    "in": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier", "$description": "Exiting elements" },
    "out": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Entering elements" },
    "in-out": { "$value": "cubic-bezier(0.42, 0, 0.58, 1)", "$type": "cubicBezier", "$description": "Symmetric animations" },
    "morph": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier", "$description": "Dual-radius shape morphs" },
    "peel": { "$value": "cubic-bezier(0.33, 1, 0.68, 1)", "$type": "cubicBezier", "$description": "Lift-off / peel exits" },
    "bounce": { "$value": "cubic-bezier(0.68, -0.55, 0.265, 1.55)", "$type": "cubicBezier", "$description": "Playful emphasis" }
  },
  "zIndex": {
    "below": { "$value": "-1", "$type": "number", "$description": "Background elements" },
    "base": { "$value": "0", "$type": "number", "$description": "Default stacking" },
    "above": { "$value": "1", "$type": "number", "$description": "Above siblings" },
    "dropdown": { "$value": "1000", "$type": "number" },
    "sticky": { "$value": "1020", "$type": "number" },
    "fixed": { "$value": "1030", "$type": "number" },
    "modal-backdrop": { "$value": "1040", "$type": "number" },
    "modal": { "$value": "1050", "$type": "number" },
    "popover": { "$value": "1060", "$type": "number" },
    "tooltip": { "$value": "1070", "$type": "number" },
    "toast": { "$value": "1080", "$type": "number" }
  },
  "breakpoint": {
    "xs": { "$value": "0", "$type": "dimension" },
    "sm": { "$value": "576px", "$type": "dimension" },
    "md": { "$value": "768px", "$type": "dimension" },
    "lg": { "$value": "992px", "$type": "dimension" },
    "xl": { "$value": "1200px", "$type": "dimension" },
    "xxl": { "$value": "1400px", "$type": "dimension" }
  },
  "haptic": {
    "$description": "Behavior tokens (not CSS). Semantic haptic events — patterns are adapter-internal. See haptics.md. Separate channel from visual/AT action feedback.",
    "tap": { "$value": "tap", "$type": "string", "$description": "Discrete commit ack (web pattern [10]ms)" },
    "select": { "$value": "select", "$type": "string", "$description": "Selection changed (web pattern [5]ms)" },
    "retry-ack": { "$value": "retry-ack", "$type": "string", "$description": "Retry attempt accepted — every press (web pattern [10]ms)" },
    "success": { "$value": "success", "$type": "string", "$description": "Positive terminal outcome (web pattern [10,50,10]ms)" },
    "warning": { "$value": "warning", "$type": "string", "$description": "Caution terminal outcome (web pattern [10,40,10]ms)" },
    "error": { "$value": "error", "$type": "string", "$description": "Failure terminal outcome (web pattern [30,50,30]ms)" }
  }
}
