{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "verbosity": "high",
    "permissions": "prompt",
    "tps": true
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  },
  "mouse": false,
  "terminal": {
    "title": false
  },
  "debug": {
    "devtools": false
  },
  "scroll": {
    "acceleration": true
  }
}
