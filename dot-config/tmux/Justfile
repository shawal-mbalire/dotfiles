# List available commands
default:
    @just --list

# Install dependencies (default: fedora)
deps os="fedora":
    #!/usr/bin/env bash
    if [ "{{os}}" = "mac" ]; then
        brew install fzf zoxide neovim tmux
    elif [ "{{os}}" = "fedora" ]; then
        sudo dnf install -y fzf zoxide neovim tmux
    else
        echo "Unknown OS: {{os}}. Use 'mac' or 'fedora'."
        exit 1
    fi

# Full setup: install TPM and all plugins (default: fedora)
setup os="fedora": (deps os)
    @if [ ! -d "$HOME/.config/tmux/plugins/tpm" ]; then \
        echo "Installing TPM..."; \
        git clone https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"; \
    else \
        echo "TPM already installed"; \
    fi
    TMUX_PLUGIN_MANAGER_PATH="$HOME/.config/tmux/plugins" ~/.config/tmux/plugins/tpm/bin/install_plugins
    @#!/usr/bin/env bash
    RESURRECT_DIR="$HOME/.local/share/tmux/resurrect"
    if [ -d "$RESURRECT_DIR" ]; then
        LAST=$(readlink "$RESURRECT_DIR/last" 2>/dev/null)
        if [ -n "$LAST" ] && [ ! -s "$RESURRECT_DIR/$LAST" ]; then
            echo "Warning: Empty save file $LAST, fixing..."
            rm "$RESURRECT_DIR/$LAST" "$RESURRECT_DIR/last"
            PREV=$(ls -t "$RESURRECT_DIR"/tmux_resurrect_*.txt 2>/dev/null | head -1)
            if [ -n "$PREV" ]; then
                ln -s "$(basename "$PREV")" "$RESURRECT_DIR/last"
                echo "Fixed: linked to $(basename "$PREV")"
            fi
        fi
    fi

# Reload tmux configuration
reload:
    tmux source-file ~/.config/tmux/tmux.conf

# Debug: test config without plugins
debug:
    @tmux -f ~/.config/tmux/tmux-debug.conf new-session -d && echo "Base config OK" || echo "Base config FAIL"
    @tmux kill-server 2>/dev/null || true
