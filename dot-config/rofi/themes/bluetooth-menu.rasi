configuration {
    font: "Sono 12";
    show-icons: false;
    terminal: "rofi-sensible-terminal";
    disable-history: false;
    sort: false;
    matching: "normal";
    tokenize: true;
    click-to-exit: true;
}

* {
    background:     #1E1E2EFF;
    background-alt: #313244FF;
    foreground:     #CDD6F4FF;
    selected:       #89B4FAFF;
    separator:      #45475AFF;
    background-color: @background;
}

window {
    width: 400px;
    transparency: "screenshot";
    location: north east;
    anchor: north east;
    offset: 0px 22px;
    border: 0px solid;
    border-radius: 0px 0px 12px 12px;
    opacity: 0.7;
    border-color: @selected;
    background-color: @background;
}

mainbox {
    background-color: @background;
    children: [ inputbar, listview ];
    padding: 8px;
}

inputbar {
    background-color: @background-alt;
    text-color: @foreground;
    padding: 8px 12px;
    border-radius: 5px;
}

prompt {
    text-color: @selected;
}

entry {
    text-color: @foreground;
    background-color: @background-alt;
    placeholder-color: #6C7086FF;
}

listview {
    lines: 15;
    columns: 1;
    spacing: 0px;
}

element {
    background-color: transparent;
    text-color: @foreground;
    padding: 6px 12px;
    border-radius: 0px;
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
    text-color: #000000;
    cursor: pointer;
}

element-text {
    cursor: inherit;
    background-color: transparent;
    text-color: @foreground;
}

textbox-prompt-colon {
    background-color: @background-alt;
    text-color: @foreground;
}

/* Section separator lines */
element-text.separator {
    background-color: @separator;
    text-color: @foreground;
    padding: 2px 12px;
    expand: false;
}

/* Disabled/unavailable items */
element-text.disabled {
    color: @overlay0;
    cursor: default;
}
